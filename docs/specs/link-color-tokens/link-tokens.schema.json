{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luowen.local/schema/link-tokens.v1.json",
  "title": "LuoWen Link Color Tokens",
  "description": "三级 token：primitive（原始色）→ semantic（语义色）→ component（组件）。只描述连线颜色与流向动效，不描述节点、背景、字体。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "primitive", "semantic", "component", "context"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "$description": { "type": "string" },
    "extends": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "继承的 token 文件 id；只允许覆盖 primitive / semantic 叶子 / component / context，禁止删除继承的语义键"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canvas", "card"],
      "description": "仅供门槛复算使用，不参与渲染；取宿主主题的 CLEAR_BACKGROUND_COLOR 与 NODE_DEFAULT_BGCOLOR",
      "properties": {
        "canvas": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "card": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
      }
    },
    "primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hue", "luminance", "chroma", "neutralChroma", "neutralLuminance"],
      "properties": {
        "hue": {
          "type": "object",
          "required": ["vae", "conditioning", "clip", "mask", "audio", "mesh3d", "image", "model", "latent"],
          "additionalProperties": false,
          "patternProperties": { "^[a-z][a-z0-9_-]*$": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 } }
        },
        "luminance": {
          "type": "object",
          "required": ["hi", "lo", "video"],
          "additionalProperties": false,
          "patternProperties": { "^[a-z][a-z0-9_-]*$": { "type": "number", "minimum": 0.3, "maximum": 0.95 } }
        },
        "chroma": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "neutralChroma": { "type": "number", "minimum": 0, "maximum": 0.06 },
        "neutralLuminance": {
          "type": "object",
          "required": ["scalar", "struct", "unknown"],
          "additionalProperties": false,
          "patternProperties": { "^[a-z][a-z0-9_-]*$": { "type": "number", "minimum": 0.3, "maximum": 0.95 } }
        }
      }
    },
    "semantic": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": { "^link\\.[a-z0-9-]+$": { "$ref": "#/$defs/semanticColor" } },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection"],
      "properties": {
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "flow"],
          "properties": {
            "width": { "type": "number", "minimum": 1, "maximum": 8, "description": "与宿主 connections_width 对齐，默认 3" },
            "flow": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "dash", "gap", "speed", "opacity"],
              "properties": {
                "enabled": { "type": "boolean" },
                "dash": { "type": "number", "minimum": 2, "maximum": 24 },
                "gap": { "type": "number", "minimum": 2, "maximum": 48 },
                "speed": { "type": "number", "minimum": 0, "maximum": 160, "description": "100% 缩放下的 px/s；60%/40% 时按缩放同步，不做速度补偿" },
                "opacity": { "type": "number", "minimum": 0.2, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "typeMap": {
      "type": "object",
      "description": "连线类型名 → 语义 token 的显式映射；未命中时按 typeRules 顺序匹配，再落 unknown",
      "patternProperties": { "^[A-Za-z0-9_*+-]+$": { "type": "string", "pattern": "^link\\.[a-z0-9-]+$" } },
      "additionalProperties": false
    },
    "typeRules": {
      "type": "array",
      "description": "按数组顺序依次匹配，首条命中即返回；pattern 为区分大小写的 JS 正则源码",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "token"],
        "properties": {
          "pattern": { "type": "string", "minLength": 1 },
          "token": { "type": "string", "pattern": "^link\\.[a-z0-9-]+$" }
        }
      }
    }
  },
  "$defs": {
    "semanticColor": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["hue", "luminance"],
          "properties": {
            "hue": { "type": "string", "pattern": "^primitive\\.hue\\.[a-z0-9_-]+$" },
            "luminance": { "type": "string", "pattern": "^primitive\\.luminance\\.[a-z0-9_-]+$" },
            "description": { "type": "string" }
          }
        },
        {
          "required": ["neutral"],
          "properties": {
            "neutral": { "type": "string", "pattern": "^primitive\\.neutralLuminance\\.[a-z0-9_-]+$" },
            "description": { "type": "string" }
          }
        }
      ]
    }
  }
}
