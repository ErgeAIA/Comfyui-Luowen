{
  "schemaVersion": "1.0.0",
  "id": "luowen-dark",
  "name": "LuoWen Dark 连线 token",
  "$description": "宿主深色主题（官方 Dark / obsidian_dark 量级）。仅描述连线颜色与流向动效；不含节点、背景、字体。色值全部由 primitive 推导，本文件不出现任何十六进制色值（context 除外，仅用于门槛复算）。",
  "context": {
    "canvas": "#141414",
    "card": "#353535"
  },
  "primitive": {
    "hue": {
      "vae": 22.9,
      "conditioning": 69.8,
      "clip": 105.3,
      "mask": 144.8,
      "audio": 182.9,
      "mesh3d": 211.2,
      "image": 248.8,
      "model": 291.4,
      "latent": 327.1
    },
    "luminance": {
      "hi": 0.775,
      "lo": 0.705,
      "video": 0.655
    },
    "chroma": 0.12,
    "neutralChroma": 0.02,
    "neutralLuminance": {
      "scalar": 0.66,
      "struct": 0.60,
      "unknown": 0.72
    }
  },
  "semantic": {
    "link.image": {
      "hue": "primitive.hue.image",
      "luminance": "primitive.luminance.hi",
      "description": "图像/像素/图层/预览：工作流最主流的数据形态"
    },
    "link.video": {
      "hue": "primitive.hue.image",
      "luminance": "primitive.luminance.video",
      "description": "视频帧序列：与 image 同色相，靠明度分级做冗余编码，避免新增色相挤压色盲余量"
    },
    "link.latent": {
      "hue": "primitive.hue.latent",
      "luminance": "primitive.luminance.hi",
      "description": "潜空间张量/噪声：与 image 相邻但不相连，是采样段落的分界线"
    },
    "link.conditioning": {
      "hue": "primitive.hue.conditioning",
      "luminance": "primitive.luminance.lo",
      "description": "条件/控制/参考：提示词到采样器的语义通道"
    },
    "link.clip": {
      "hue": "primitive.hue.clip",
      "luminance": "primitive.luminance.hi",
      "description": "文本编码器与视觉编码器输出"
    },
    "link.vae": {
      "hue": "primitive.hue.vae",
      "luminance": "primitive.luminance.hi",
      "description": "VAE / TAESD：图像与潜空间的转换点，用最暖色作「出入口」标记"
    },
    "link.model": {
      "hue": "primitive.hue.model",
      "luminance": "primitive.luminance.lo",
      "description": "模型权重/采样器/调度器/GUIDER；取 lo 明度带，与 image 在同色相侧拉开色盲余量"
    },
    "link.mask": {
      "hue": "primitive.hue.mask",
      "luminance": "primitive.luminance.lo",
      "description": "遮罩/分割/包围盒"
    },
    "link.audio": {
      "hue": "primitive.hue.audio",
      "luminance": "primitive.luminance.hi",
      "description": "音频/语音/编码器输出"
    },
    "link.mesh3d": {
      "hue": "primitive.hue.mesh3d",
      "luminance": "primitive.luminance.lo",
      "description": "3D 网格/体素/点云/3D 文件"
    },
    "link.scalar": {
      "neutral": "primitive.neutralLuminance.scalar",
      "description": "标量参数：STRING/INT/FLOAT/BOOLEAN/COMBO/COLOR，是「参数」而非「数据」"
    },
    "link.struct": {
      "neutral": "primitive.neutralLuminance.struct",
      "description": "结构化容器：PIPE/DICT/ARRAY/配置/模板"
    },
    "link.unknown": {
      "neutral": "primitive.neutralLuminance.unknown",
      "description": "未识别类型与通配 *：必须存在，避免未知类型落回宿主蓝色而与其他语义撞色"
    }
  },
  "component": {
    "connection": {
      "width": 3,
      "flow": {
        "enabled": false,
        "dash": 7,
        "gap": 13,
        "speed": 48,
        "opacity": 0.92
      }
    }
  },
  "typeMap": {
    "IMAGE": "link.image",
    "VIDEO": "link.video",
    "CONDITIONING": "link.conditioning",
    "STRING": "link.scalar",
    "MODEL": "link.model",
    "INT": "link.scalar",
    "LATENT": "link.latent",
    "VAE": "link.vae",
    "CLIP": "link.clip",
    "MASK": "link.mask",
    "AUDIO": "link.audio",
    "FLOAT": "link.scalar",
    "MESH": "link.mesh3d",
    "BOOLEAN": "link.scalar",
    "FILE_3D_GLB": "link.mesh3d",
    "CLIP_VISION": "link.clip",
    "CLIP_VISION_OUTPUT": "link.clip",
    "SIGMAS": "link.model",
    "SAMPLER": "link.model",
    "RECRAFT_COLOR": "link.conditioning",
    "GUIDER": "link.model",
    "NOISE": "link.latent",
    "ARRAY": "link.struct",
    "VOXEL": "link.mesh3d",
    "*": "link.unknown",
    "ELEVENLABS_VOICE": "link.audio",
    "FILE_3D_FBX": "link.mesh3d",
    "COMBO": "link.scalar",
    "SVG": "link.image",
    "AUDIO_ENCODER_OUTPUT": "link.audio",
    "FILE_3D": "link.mesh3d",
    "FISHAUDIO_VOICE": "link.audio",
    "FILE_3D_OBJ": "link.mesh3d",
    "TRACKS": "link.video",
    "BACKGROUND_REMOVAL": "link.image",
    "DICT": "link.struct",
    "RECRAFT_CONTROLS": "link.conditioning",
    "CONTROL_NET": "link.conditioning",
    "LUMA_REF": "link.conditioning",
    "RECRAFT_V3_STYLE": "link.conditioning",
    "BOUNDING_BOX": "link.mask",
    "MHR_POSE_DATA": "link.struct",
    "WAN_CAMERA_EMBEDDING": "link.conditioning",
    "SPLAT": "link.mesh3d",
    "PIXVERSE_TEMPLATE": "link.struct",
    "LATENT_OPERATION": "link.latent",
    "SAM3D_BODY_MODEL": "link.mesh3d",
    "AUDIO_ENCODER": "link.audio",
    "SHAPE_SUBDIVIDES": "link.struct",
    "MOGE_MODEL": "link.model",
    "MOGE_GEOMETRY": "link.mesh3d",
    "GEMINI_INPUT_FILES": "link.conditioning",
    "KREA_STYLE_REF": "link.conditioning",
    "STYLE_MODEL": "link.model",
    "MODEL_PATCH": "link.model",
    "LATENT_UPSCALE_MODEL": "link.model",
    "LOAD3D_CAMERA": "link.struct",
    "LAYERS": "link.image",
    "COLOR": "link.scalar",
    "OPENAI_CHAT_CONFIG": "link.struct",
    "UPSCALE_MODEL": "link.model",
    "SAM3_TRACK_DATA": "link.struct"
  },
  "typeRules": [
    { "pattern": "CAMERA_EMBED|TEXT_?EMBEDS?|CONDITION|GUIDER|CONTROL|STYLE_REF|PROMPT|KEYFRAME|CONCEPTS|ANGLE|CONTEXT|INPUT_FILES|_REF$", "token": "link.conditioning" },
    { "pattern": "TRACK_DATA|TASK_ID|HOOK|MATCHTYPE|CAMERA|PIPE|DICT|ARRAY|CONFIG|TEMPLATE|ARGS|PARAMETERS|OPTIONS|BUS|ID_INFO|INDEXES|CACHE|ACCUMULATION|^X_?Y$|^XY$|^VHS_BatchManager$", "token": "link.struct" },
    { "pattern": "MESH|VOXEL|SPLAT|3D|GEOMETRY", "token": "link.mesh3d" },
    { "pattern": "MODEL|LORA|CHECKPOINT|SAMPLER|SIGMAS|UPSCALER|ADAPTER|SCHEDULER|TIMESTEP|DIT|BLOCK|INSIGHTFACE|GLIGEN|CLASSIFIER", "token": "link.model" },
    { "pattern": "VIDEO|TRACKS|TRACKING", "token": "link.video" },
    { "pattern": "AUDIO|VOICE|TTS|SPEECH|SOUND", "token": "link.audio" },
    { "pattern": "MASK|SEG|BOX|BOUND", "token": "link.mask" },
    { "pattern": "CLIP|TEXT_?ENCODER", "token": "link.clip" },
    { "pattern": "VAE|TAESD", "token": "link.vae" },
    { "pattern": "LATENT|NOISE|EMBED", "token": "link.latent" },
    { "pattern": "IMAGE|LAYER|SVG|PREVIEW|PIXEL|HISTOGRAM|OPTICAL_FLOW|LOSS_MAP|PHOTOMAKER|SEAM|FILENAMES", "token": "link.image" },
    { "pattern": "STRING|INT|FLOAT|BOOLEAN|COMBO|NUMBER|COLOR|SEED|TIMER", "token": "link.scalar" },
    { "pattern": "DATA|LIST|PATH|CURVE|OVERLAP", "token": "link.struct" }
  ]
}
